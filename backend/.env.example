# Copy this file to .env and fill in real values before running the backend.
# .env is gitignored -- never commit real secrets or DB credentials.

# "development" or "production". In production the app REFUSES TO START if
# SECRET_KEY is still the placeholder below, is shorter than 32 characters,
# or if CORS_ORIGINS is empty -- see app/core/config.py::_validate_secrets.
# Locally these are warnings instead, so a fresh clone runs with no setup.
ENVIRONMENT=development

# Only for running the backend directly on your machine (section 3 of the
# README). Every Docker Compose service is handed its own DATABASE_URL, built
# from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB in the ROOT .env -- this
# line has no effect on the containers.
#
# The user/password/database deliberately match the Compose ones so a database
# client configured for one works for the other. This used to read
# `exam_user:exam_pass@.../exam_proctor`, left over from an earlier name of the
# project: credentials nothing had used in a long time, sitting in the most
# authoritative-looking place anyone would look them up.
DATABASE_URL=postgresql://merit_ai:change_this_password@localhost:5432/merit_ai

# REQUIRED: generate a real secret before running anything but a throwaway
# local instance. The value below is a public placeholder -- anyone who has
# ever seen this repo can forge a valid JWT (including an admin token) against
# a deployment still using it. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_this_to_a_long_random_secret_key

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
UPLOAD_DIR=uploads

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

AI_SERVICE_URL=http://localhost:8010
AI_SERVICE_TIMEOUT_SECONDS=20

# Cosine distance between two ArcFace embeddings; lower = stricter, 0 = identical.
# The ai_worker and the in-process model both run ArcFace, so this one value
# applies to both. See app/ai/face_service.py. Keep this strict (<=0.4) -- a
# false accept means a different person can sit the exam undetected.
FACE_MATCH_TOLERANCE=0.38
# InsightFace model pack for the in-process face path.
#   buffalo_l -- ~280MB, best accuracy (matches the ai_worker)
#   buffalo_s -- ~16MB, much quicker first-run download
# Weights are fetched on first use and cached under FACE_MODEL_ROOT.
FACE_MODEL_NAME=buffalo_l
FACE_MODEL_ROOT=models/insightface
# Reserved for a future server-side noise check; current noise detection runs
# entirely client-side (frontend/src/lib/proctoring.js), so this has no
# effect yet. See app/core/config.py.
NOISE_DB_THRESHOLD=65.0

# Exam lockdown: violations before an attempt is auto-submitted, and the
# window (seconds) that collapses one physical action (e.g. Alt-Tab firing
# blur + visibilitychange together) into a single strike. See
# app/services/lockdown_service.py.
LOCKDOWN_STRIKE_LIMIT=3
LOCKDOWN_STRIKE_DEBOUNCE_SECONDS=3.0

# Sandboxed coding-question execution (app/services/code_runner_service.py).
# Requires the `docker` CLI on the host; set to false to disable coding
# questions entirely rather than have them fail per-submission.
CODE_EXECUTION_ENABLED=true
CODE_EXECUTION_DEFAULT_TIMEOUT_SECONDS=6
CODE_EXECUTION_MEMORY_LIMIT=128m
CODE_EXECUTION_CPUS=0.5
# Max sandbox containers running at once across all students. Roughly
# (host cores / CODE_EXECUTION_CPUS) is a reasonable starting point.
CODE_EXECUTION_MAX_CONCURRENT=4
