# docker-compose.yml reads this file automatically (a plain `.env` in the
# same directory as the compose file). Copy it to `.env` and fill in real
# values before running `docker compose up`. `.env` is gitignored -- never
# commit real secrets here.
#
# This is separate from backend/.env.example, which is for running the
# backend directly on your machine (no Docker) -- see the root README's
# Docker section for when to use which.

# --- Postgres -----------------------------------------------------------
POSTGRES_USER=merit_ai
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=merit_ai

# --- Core API -------------------------------------------------------------
# "development" or "production". In production, core-api REFUSES TO START
# if SECRET_KEY is still a placeholder, shorter than 32 characters, or if
# CORS_ORIGINS is empty -- see backend/app/core/config.py::_validate_secrets.
ENVIRONMENT=production

# REQUIRED. Generate a real one before running anything but a throwaway
# local stack -- this signs every JWT, including admin tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_this_to_a_long_random_secret_key

# The origin(s) a browser will actually load this app from. With the bundled
# reverse proxy (see docker-compose.yml's `proxy` service) that's just the
# proxy's own public address.
CORS_ORIGINS=http://localhost

ACCESS_TOKEN_EXPIRE_MINUTES=120

# Cosine distance between two ArcFace embeddings; lower = stricter. Shared by
# core-api and ai-worker's /face/verify request payload (see
# app/ai/ai_worker_client.py) so both always compare against the same
# threshold regardless of which container computed the embedding.
FACE_MATCH_TOLERANCE=0.38

# InsightFace model pack, shared by core-api's local fallback and ai-worker's
# primary path. buffalo_l = ~280MB, best accuracy. buffalo_s = ~16MB, much
# faster first-run download.
FACE_MODEL_NAME=buffalo_l

LOCKDOWN_STRIKE_LIMIT=3

# Sandboxed coding-question execution (backend/app/services/code_runner_service.py).
# core-api talks to the HOST's Docker daemon via a mounted socket (see
# docker-compose.yml) to run each test case in its own ephemeral container --
# there is no Docker-in-Docker here.
CODE_EXECUTION_ENABLED=true
CODE_EXECUTION_MAX_CONCURRENT=4

# The GID of the `docker` group on the HOST machine running `docker compose
# up`, so core-api's non-root appuser can actually use the mounted
# /var/run/docker.sock instead of hitting "permission denied" on every
# code-runner request. Find it with:
#   getent group docker | cut -d: -f3
# On Docker Desktop (macOS/Windows) the socket is typically already
# world-accessible and this can usually be left at the default.
DOCKER_GID=999

# Seeds the three roles, and the FIRST admin account, on core-api boot if they
# don't already exist. Idempotent -- it never overwrites an existing password.
#
# There is no longer a hard-coded default credential. Behaviour depends on
# SEED_ADMIN_PASSWORD below:
#   set                        -> that admin is created, password never logged
#   unset + ENVIRONMENT=production -> NO admin created, and the log says why
#   unset + development        -> a random password is generated and printed once
AUTO_SEED_ADMIN=true

# The first administrator. Required in production -- without it no admin is
# created at all, which is deliberately preferable to creating a guessable one.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(16))"
SEED_ADMIN_EMAIL=admin@merit.ai
SEED_ADMIN_PASSWORD=

# --- Outbound email ---------------------------------------------------------
# Powers OTP signup verification, self-service password reset, the examiner
# access-request notification to an admin, credential delivery to a newly
# approved examiner, and the exam published/starting-soon notices.
#
# Everything here is OPTIONAL. Left off, all of the above degrade to a logged
# no-op and the rest of the app behaves exactly as it did before email existed
# -- see backend/app/services/email_service.py. The OTP endpoints are the one
# exception: they return a clear 503 rather than telling someone to check an
# inbox for a message that can never arrive.
EMAIL_ENABLED=false

# Gmail setup, start to finish:
#   1. Use a dedicated account (e.g. admin.merit.ai@gmail.com), not a personal one.
#   2. Turn ON 2-Step Verification -- App Passwords do not exist without it.
#   3. https://myaccount.google.com/apppasswords -> generate one for "Mail".
#   4. Paste the 16 characters below WITHOUT the spaces Google displays.
# The account password will NOT work here; Google rejects plain-password SMTP.
# Gmail's cap is roughly 500 recipients/day.
SMTP_HOST=smtp.gmail.com
# 587 with SMTP_USE_TLS=true (STARTTLS), or 465 with SMTP_USE_TLS=false
# (implicit TLS). The port and the flag must agree or the connection hangs
# until it times out instead of failing with something readable.
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=admin.merit.ai@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# Defaults to SMTP_USERNAME when blank. Gmail silently rewrites a From: that
# doesn't match the authenticated account, so on Gmail leave this alone.
EMAIL_FROM=
EMAIL_FROM_NAME=Merit.Ai

# Where "an examiner has requested an account" notifications go. When blank,
# they fan out to every active admin account in the database instead.
ADMIN_NOTIFICATION_EMAIL=admin.merit.ai@gmail.com

# Used to build absolute links in emails -- a relative /login means nothing in
# an inbox. Should match the origin people actually load the app on, i.e. the
# same value as CORS_ORIGINS above in a single-origin deployment.
APP_BASE_URL=http://localhost

# --- Biometric data lifecycle ------------------------------------------------
# This platform stores face photos, ArcFace embeddings, ID-card images and
# violation screenshots. See backend/app/services/biometric_service.py.
#
# The consent wording in force. Bump this string whenever the text shown to
# candidates at capture time changes -- every earlier consent is then correctly
# reported as stale rather than silently inheriting agreement to new terms.
BIOMETRIC_CONSENT_VERSION=2026-08-04.v1

# Days after a candidate's LAST ATTEMPT before their biometric data becomes
# eligible for automatic deletion. Measured from last activity, not capture
# date, so a dormant account is purged but an active candidate's identity
# evidence survives an open appeal.
#
# 0 = never auto-delete, and that is the default deliberately: the right period
# is a legal and institutional decision, and a default that quietly destroyed
# evidence mid-dispute would be worse than one that keeps too much. Manual
# deletion (DELETE /api/v1/users/me/biometrics, or the admin equivalent) works
# regardless of this setting.
BIOMETRIC_RETENTION_DAYS=0
BIOMETRIC_PURGE_INTERVAL_HOURS=24

# --- One-time passcodes -----------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Exam reminders ---------------------------------------------------------
# A background loop in core-api emails the address an examiner nominated on the
# exam, once, shortly before it starts. Never starts at all when email is
# disabled -- see backend/app/services/reminder_service.py.
EXAM_REMINDER_ENABLED=true
EXAM_REMINDER_MINUTES_BEFORE=5
# Must stay comfortably below EXAM_REMINDER_MINUTES_BEFORE: the scheduler looks
# at a bounded window, and a poll interval wider than that window steps over it.
EXAM_REMINDER_POLL_SECONDS=60

# --- Reverse proxy ----------------------------------------------------------
# The one port this stack publishes to the host.
HTTP_PORT=80
