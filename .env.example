# Copy to `.env` in this directory; docker-compose.yml reads it automatically.
# Set SECRET_KEY, POSTGRES_PASSWORD and REDIS_PASSWORD before anything but a local stack.

# --- Postgres -----------------------------------------------------------
POSTGRES_USER=merit_ai
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=merit_ai

# --- Redis ---
# Shared rate-limit counters, one-time-passcode state,
# distributed locks, and the RQ background job/email queue.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=change_this_password
# core-api, scheduler and worker all read this. The default already points at the bundled
# `redis` service over the internal `cache-net` network (see docker-compose.yml).
REDIS_URL=redis://redis:6379/0

# --- Core API ---
# "development" or "production". In production, core-api REFUSES TO START if SECRET_KEY is still
# a placeholder, shorter than 32 characters, or if CORS_ORIGINS is empty.
ENVIRONMENT=production

# REQUIRED. Generate a real one before running anything but a throwaway
# local stack -- this signs every JWT, including admin tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_this_to_a_long_random_secret_key

# The origin(s) a browser will actually load this app from. With the bundled reverse proxy (see
# docker-compose.yml's `proxy` service) that's just the proxy's own public address.
CORS_ORIGINS=http://localhost

ACCESS_TOKEN_EXPIRE_MINUTES=120

# Cosine distance between two ArcFace embeddings; lower = stricter.
FACE_MATCH_TOLERANCE=0.38

# InsightFace model pack, shared by core-api's local fallback and ai-worker's primary path.
# buffalo_l = ~280MB, best accuracy. buffalo_s = ~16MB, much faster first-run download.
FACE_MODEL_NAME=buffalo_l

LOCKDOWN_STRIKE_LIMIT=3

# Sandboxed coding-question execution (backend/app/services/code_runner_service.py). core-api
# talks to the HOST's Docker daemon via a mounted socket (see docker-compose.yml) to run each
# test case in its own ephemeral container.
CODE_EXECUTION_ENABLED=true
CODE_EXECUTION_MAX_CONCURRENT=4

# The GID of the `docker` group on the HOST machine running `docker compose up`, so core-api's
# non-root appuser can actually use the mounted /var/run/docker.sock instead of hitting
# "permission denied" on every code-runner request.
DOCKER_GID=999

# Seeds the three roles, and the FIRST admin account,
# on core-api boot if they don't already exist.
AUTO_SEED_ADMIN=true

# The first administrator. Required in production.
SEED_ADMIN_EMAIL=admin@merit.ai
SEED_ADMIN_PASSWORD=

# --- Outbound email ---
# Powers OTP signup verification, self-service password reset, the examiner access-request
# notification to an admin, credential delivery to a newly approved examiner, and the exam
# published/starting-soon notices.
EMAIL_ENABLED=false

# Gmail: use a dedicated account, enable 2-Step Verification, then create an App Password
# (Google Account -> Security -> App passwords) and paste the 16 characters below.
SMTP_HOST=smtp.gmail.com
# 587 with SMTP_USE_TLS=true (STARTTLS), or 465 with SMTP_USE_TLS=false (implicit TLS).
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=admin.merit.ai@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# Defaults to SMTP_USERNAME when blank. Gmail silently rewrites a From: that
# doesn't match the authenticated account, so on Gmail leave this alone.
EMAIL_FROM=
EMAIL_FROM_NAME=Merit.Ai

# Where "an examiner has requested an account" notifications go. When blank,
# they fan out to every active admin account in the database instead.
ADMIN_NOTIFICATION_EMAIL=admin.merit.ai@gmail.com

APP_BASE_URL=http://localhost

# --- Biometric data lifecycle ---
# This platform stores face photos, ArcFace embeddings,
# ID-card images and violation screenshots.
BIOMETRIC_CONSENT_VERSION=2026-08-04.v1

# Days after a candidate's LAST ATTEMPT before their
# biometric data becomes eligible for automatic deletion.
BIOMETRIC_RETENTION_DAYS=0
BIOMETRIC_PURGE_INTERVAL_HOURS=24

# --- One-time passcodes -----------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Account activation ---
# How long an activation link stays valid. Days rather than minutes: an examiner approved on a
# Friday should still be able to open the link on Monday.
ACTIVATION_TTL_HOURS=72

# --- Registration mode ---
# "open"   - anyone can create a candidate account (right for evaluating this).
# "invite" - only addresses already on an exam or organization roster may register
#            (right for an institution); reuses rosters an exam already requires.
REGISTRATION_MODE=open

# Email examiner and admin accounts when their account is signed into.
NOTIFY_STAFF_ON_LOGIN=true

# Minimum gap between two admin notifications about the SAME pending access request.
ACCESS_REQUEST_RENOTIFY_SECONDS=900

# --- Email outbox (backend/app/services/email_service.py) ---
# Every transactional email this app sends -- an admin access-request notification, an examiner
# activation link and its resend, a student signup/password-reset OTP code, an exam notice, a
# report-ready email -- is written to the `email_outbox` table BEFORE delivery is attempted (the
# permanent record of status/attempts/error/sent-time PostgreSQL is required to keep) and queued
# for delivery on Redis/RQ's "emails" queue, retried with this base/max backoff by the `worker`
# service if an attempt fails -- see docker-compose.yml's `worker` service,
# backend/app/core/queues.py and backend/app/worker/jobs.py.
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_OUTBOX_RETRY_BASE_SECONDS=60
EMAIL_OUTBOX_RETRY_MAX_SECONDS=3600

# --- Background job queue (backend/app/core/queues.py, backend/app/worker/) ---
# RQ over Redis.
JOB_MAX_RETRIES=3
# Ceiling on how long the worker lets one job run before treating it as stuck.
JOB_TIMEOUT_SECONDS=300
# How many `worker` container replicas to run. Safe to scale freely -- RQ
# workers claim jobs from Redis atomically.
JOB_WORKER_REPLICAS=1

# --- Rate limiting (backend/app/core/rate_limit.py) ---
# Redis-backed, shared across every core-api worker and replica.
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Per-USER, for the CPU-expensive proctoring endpoints (face/ID verify, object
# detection, pose check) and coding-question execution.
AI_RATE_LIMIT_MAX_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=60

# --- Distributed locks (backend/app/core/locks.py) ---
# Default hold time for a lock whose caller doesn't specify one.
LOCK_DEFAULT_TTL_SECONDS=30

# --- Exam reminders ---------------------------------------------------------
# A background loop in core-api emails the address an examiner nominated on the
# exam, once, shortly before it starts. Never starts at all when email is
# disabled -- see backend/app/services/reminder_service.py.
EXAM_REMINDER_ENABLED=true
EXAM_REMINDER_MINUTES_BEFORE=5
# Must stay comfortably below EXAM_REMINDER_MINUTES_BEFORE: the scheduler looks
# at a bounded window, and a poll interval wider than that window steps over it.
EXAM_REMINDER_POLL_SECONDS=60

# --- Reverse proxy ----------------------------------------------------------
# The one port this stack publishes to the host.
HTTP_PORT=80

# --- account policy ---
# Refuse student self-registration without a verified email address.
REQUIRE_EMAIL_VERIFICATION=true

# Minimum length for new passwords. No character-class rules by design -- see
# backend/app/core/passwords.py.
PASSWORD_MIN_LENGTH=10

# Networks whose X-Forwarded-For header may be believed. Behind a reverse proxy the TCP peer is
# the proxy, so without this every user behind it shares one rate-limit budget.
TRUSTED_PROXY_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.1/32

# Refuse a registration that does not carry the consent the form asks for.
REQUIRE_CONSENT_ON_SIGNUP=true
